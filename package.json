const state = {
  sessionId: '',
  currentTarget: 'alas',
  level: 'penerapan',
  currentQuestionIndex: 0,
  selectedAnswer: null,
  answered: false,
  questionSeed: 0
};

const doc = document;

function getSessionIdFromUrl() {
  const params = new URLSearchParams(window.location.search);
  return params.get('sessionId') || '';
}

function generateSessionId() {
  return `scan-${Math.random().toString(36).slice(2, 10)}-${Date.now().toString(36)}`;
}

function updateSessionId() {
  const url = new URL(window.location.href);
  if (!state.sessionId) {
    state.sessionId = getSessionIdFromUrl() || generateSessionId();
  }

  url.searchParams.set('sessionId', state.sessionId);
  window.history.replaceState({}, '', url);
  doc.querySelector('#sessionId').textContent = state.sessionId.slice(0, 12);

  const qrUrl = encodeURIComponent(`${window.location.origin}${window.location.pathname}?sessionId=${state.sessionId}`);
  doc.querySelector('#qrImage').src = `https://api.qrserver.com/v1/create-qr-code/?data=${qrUrl}&size=180x180&format=png`;
}

function showConcept(target) {
  state.currentTarget = target;
  const current = conceptMap[target];
  if (!current) return;

  doc.querySelector('#conceptTitle').textContent = current.title;
  doc.querySelector('#conceptBadge').textContent = current.badge;
  doc.querySelector('#conceptText').textContent = current.text;
  doc.querySelector('#conceptFormula').textContent = current.formula;
  doc.querySelector('#conceptDerivation').textContent = current.derivation;

  doc.querySelectorAll('.spot-btn').forEach((button) => {
    button.classList.toggle('active', button.dataset.target === target);
  });

  const svg = doc.querySelector('.cone-svg');
  svg.querySelectorAll('.point-group').forEach((group) => {
    const active = group.dataset.target === target;
    group.querySelector('.point-ring').style.fill = active ? 'rgba(157, 241, 202, 0.14)' : 'rgba(255,255,255,0.12)';
    group.querySelector('.point-ring').style.stroke = active ? '#9df1ca' : 'rgba(104, 213, 255, 0.8)';
  });
}

function hashString(str) {
  let hash = 0;
  for (let i = 0; i < str.length; i += 1) {
    hash = str.charCodeAt(i) + ((hash << 5) - hash);
  }
  return hash;
}

function randomFromSeed(seed, min, max) {
  const x = Math.sin(seed) * 10000;
  return min + (x - Math.floor(x)) * (max - min);
}

function pickQuestion(level) {
  const pool = questionBank[level];
  const baseSeed = hashString(`${state.sessionId}-${state.level}`);
  const index = Math.abs(Math.floor(randomFromSeed(baseSeed, 0, pool.length))) % pool.length;
  state.currentQuestionIndex = index;
  return pool[index];
}

function renderQuestion() {
  const set = questionBank[state.level];
  const selectedQuestion = set[state.currentQuestionIndex] || pickQuestion(state.level);
  const questionText = doc.querySelector('#questionText');
  const optionContainer = doc.querySelector('#answerOptions');

  questionText.textContent = selectedQuestion.question;
  optionContainer.innerHTML = '';

  selectedQuestion.options.forEach((option, index) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'answer-option';
    button.textContent = `${String.fromCharCode(65 + index)}. ${option}`;
    button.dataset.index = String(index);

    button.addEventListener('click', () => {
      if (state.answered) return;
      state.selectedAnswer = Number(index);
      doc.querySelectorAll('.answer-option').forEach((item) => {
        item.classList.toggle('selected', Number(item.dataset.index) === state.selectedAnswer);
      });
    });

    optionContainer.appendChild(button);
  });

  const feedback = doc.querySelector('#feedback');
  feedback.classList.add('hidden');
  feedback.className = 'feedback hidden';
  state.selectedAnswer = null;
  state.answered = false;
}

function checkAnswer() {
  const currentQuestion = questionBank[state.level][state.currentQuestionIndex];
  const feedback = doc.querySelector('#feedback');

  if (state.selectedAnswer === null) {
    feedback.textContent = 'Pilih salah satu jawaban terlebih dahulu.';
    feedback.className = 'feedback error';
    feedback.classList.remove('hidden');
    return;
  }

  const isCorrect = state.selectedAnswer === currentQuestion.answer;
  feedback.classList.remove('hidden');

  if (isCorrect) {
    feedback.textContent = `Benar! ${currentQuestion.explanation}`;
    feedback.className = 'feedback success';
  } else {
    feedback.textContent = `Jawabanmu belum tepat. ${currentQuestion.explanation}`;
    feedback.className = 'feedback error';
  }

  state.answered = true;
  doc.querySelectorAll('.answer-option').forEach((option) => {
    const optionIndex = Number(option.dataset.index);
    if (optionIndex === currentQuestion.answer) {
      option.classList.add('correct');
    }
    if (optionIndex === state.selectedAnswer && optionIndex !== currentQuestion.answer) {
      option.classList.add('wrong');
    }
  });
}

function changeLevel(level) {
  state.level = level;
  doc.querySelectorAll('.level-btn').forEach((button) => {
    button.classList.toggle('active', button.dataset.level === level);
  });
  doc.querySelector('#levelBadge').textContent = level.charAt(0).toUpperCase() + level.slice(1);

  const pool = questionBank[level];
  state.currentQuestionIndex = Math.abs(hashString(`${state.sessionId}-${level}-${Date.now()}`)) % pool.length;
  renderQuestion();
}

function init() {
  updateSessionId();
  showConcept('alas');
  changeLevel('penerapan');

  doc.querySelectorAll('.spot-btn').forEach((button) => {
    button.addEventListener('click', () => showConcept(button.dataset.target));
  });

  doc.querySelectorAll('.level-btn').forEach((button) => {
    button.addEventListener('click', () => changeLevel(button.dataset.level));
  });

  doc.querySelector('#newSessionBtn').addEventListener('click', () => {
    state.sessionId = generateSessionId();
    updateSessionId();
    changeLevel(state.level);
    showConcept(state.currentTarget);
  });

  doc.querySelector('#checkAnswerBtn').addEventListener('click', checkAnswer);
  doc.querySelector('#nextQuestionBtn').addEventListener('click', () => {
    const pool = questionBank[state.level];
    state.currentQuestionIndex = (state.currentQuestionIndex + 1) % pool.length;
    renderQuestion();
  });
}

init();

window.addEventListener('load', () => {
  const qrImage = doc.querySelector('#qrImage');
  qrImage.alt = `QR code untuk sesi ${state.sessionId}`;
});

window.addEventListener('hashchange', () => {
  const currentTarget = location.hash.replace('#', '');
  if (conceptMap[currentTarget]) {
    showConcept(currentTarget);
  }
});

window.addEventListener('keydown', (event) => {
  if (event.key === 'n' || event.key === 'N') {
    state.sessionId = generateSessionId();
    updateSessionId();
    changeLevel(state.level);
  }
});

// Optional: allow direct URL links for target concept by hash
const activeTarget = window.location.hash.replace('#', '');
if (conceptMap[activeTarget]) {
  showConcept(activeTarget);
}

// Prevent old session from breaking if page reloads in same scan
const search = new URLSearchParams(window.location.search);
if (!search.has('sessionId')) {
  search.set('sessionId', state.sessionId || generateSessionId());
  history.replaceState(null, '', `${window.location.pathname}?${search.toString()}`);
}

state.sessionId = getSessionIdFromUrl() || generateSessionId();
updateSessionId();
changeLevel('penerapan');

if (!window.location.hash) {
  showConcept('alas');
}

// Simulate a QR scan by using explicit session ID from URL, so each mobile scan can be different.
if (state.sessionId) {
  const qrImage = doc.querySelector('#qrImage');
  qrImage.setAttribute('src', `https://api.qrserver.com/v1/create-qr-code/?data=${encodeURIComponent(`${window.location.origin}${window.location.pathname}?sessionId=${state.sessionId}`)}&size=180x180&format=png`);
}

module.exports = {
  conceptMap,
  questionBank,
  state,
  pickQuestion,
  showConcept,
  changeLevel
};

